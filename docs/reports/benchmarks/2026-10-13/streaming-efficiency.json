  "scope": "Source optimizations after v0.0.1104-beta. Synthetic component and algorithm workloads, not a whole-app or energy benchmark.",
  "choices": [
    {
      "area": "SSE",
      "before": "Repeated delimiter searches and growing-prefix scans; worst-case quadratic work.",
      "after": "Single native regular-expression scan per chunk; join each complete line once.",
      "alternative": "A JavaScript character loop was slower in the compared fixtures."
    },
    {
      "area": "RPC framing",
      "before": "Search the entire accumulated unfinished line for every chunk.",
      "after": "Scan new bytes once; retain bounded incomplete bytes and count discarded bytes without copying them."
    },
    {
      "area": "Event replay",
      "before": "Scan the entire ring and grow the result slice.",
      "after": "Use contiguous sequence numbers to locate only the unread tail; preallocate unfiltered results."
    },
    {
      "area": "History rendering",
      "before": "Changing attachment callbacks invalidated memoized historical messages.",
      "after": "Stable action proxies read the latest committed callback; only changed messages render."
    },
    {
      "area": "Icons and motion",
      "before": "Flex layouts could collapse icon width; streaming cursor animated indefinitely.",
      "after": "Non-shrinking decorative SVGs; opacity animation ends after four iterations and remains disabled under reduced motion."
    }
  ],
  "tradeoffs": [
    "SSE single-event chunks and RPC short lines show small extra per-record overhead; raw samples retain those regressions.",
    "Registering cancellable contexts uses 472 extra bytes in the sampled short-lived subscription case while avoiding retained watchers and references after cancellation.",
    "No additional renderer, animation library, global memoization, global will-change, or queue-algorithm replacement was introduced.",
    "Parser allocation peaks exclude prebuilt inputs and are not process RSS; no GPU utilization or battery-power claim is made."
  ],
