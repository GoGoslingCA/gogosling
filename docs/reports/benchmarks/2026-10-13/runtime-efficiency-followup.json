  "scope": "Source optimization after the published beta; local synthetic data only. These measurements do not quantify whole-app frames, GPU utilization or energy.",
  "changes": [
    {
      "area": "Draft editing",
      "problem": "Every edit and unchanged render serialized the full content multiple times, then scanned all retained controllers.",
      "change": "Compare exact contract fields and track dirty controllers incrementally; serialize exact save tokens only when needed.",
      "expected": "Less synchronous input work and fewer aggregate notifications. No draft eviction or weaker save token."
    },
    {
      "area": "Draft lifetime and consistency",
      "problem": "Late responses after disposal could schedule new saves or continue pages. Baseline changes could become clean incorrectly; attachment key order could block cleanup.",
      "change": "Guard queued and post-await work after disposal, track baseline dirty state independently, and normalize attachment fields in fixed order.",
      "expected": "No follow-on requests from disposed scopes; required saves and completed-send cleanup remain correct. Requests already sent may still finish."
    },
    {
      "area": "Live state",
      "problem": "Each foreground flush copied all retained runs and scanned all sessions; repeated unsubscribe could remove a replacement subscription.",
      "change": "Partition store state by session, retain global run ownership, process only affected sessions, batch eligible cleanup, and make unsubscribe idempotent.",
      "expected": "Update work depends on the affected session, not unrelated retained drafts. Terminal unpersisted content remains available."
    },
    {
      "area": "Permission matching",
      "problem": "Recursive double-star matching repeatedly enumerated path partitions on failing suffixes.",
      "change": "Iteratively backtrack to the latest double-star: at most O(pattern_segments * path_segments) segment comparisons and O(1) extra state.",
      "expected": "Bounded comparison growth without changing rule results or approval decisions."
    },
    {
      "area": "Provider message assembly",
      "problem": "Repeated string concatenation copied growing assistant text prefixes.",
      "change": "Collect adjacent text fragments and join once per tool boundary.",
      "expected": "Linear text assembly; text, ordering and provider payloads are unchanged."
    },
    {
      "area": "RPC lifetime and response identity",
      "problem": "Closed connections still serialized discarded payloads; Python bool values could match integer request IDs or error codes.",
      "change": "Check closed before serialization and require exact integer types for numeric responses.",
      "expected": "Avoid unused body allocations and false errors after close; malformed responses cannot complete another request."
    }
  ],
