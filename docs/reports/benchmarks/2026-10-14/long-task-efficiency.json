  "ciStatus": "Not asserted in this pre-commit evidence record.",
  "scope": {
    "publicAPIChanged": false,
    "openAPIChanged": false,
    "databaseSchemaChanged": false,
    "newRuntimeDependencies": false,
    "internalInterfaces": "Draft reader subscriptions, snapshot invalidation, operation leases, and attachment merge helpers are frontend implementation details."
  },
  "changes": [
    {
      "area": "Tool event updates",
      "problem": "Long runs repeatedly scanned and mapped the entire tool array.",
      "cause": "Every start and completion searched by ID and executed an update callback for every entry.",
      "change": "Transfer a derived weak-keyed ID index to each immutable successor array; rebuild it for an older snapshot branch.",
      "expectedEffect": "Fewer lookups and callbacks while preserving order, complete results, first-match behavior, and immutable snapshots. Array copies remain O(n)."
    },
    {
      "area": "Tool history rendering",
      "problem": "Hidden histories still mounted hundreds of cards and progress rows.",
      "cause": "All records rendered inside collapsed sections; interleaved progress text could multiply per-section display budgets.",
      "change": "Share a 20-record budget across each persisted message; mount older records on demand in 40-record pages. Keep live unfinished tools visible and recent progress at four rows.",
      "expectedEffect": "Bound common-case DOM work without removing records, reordering text or attachments, or delaying approval controls."
    },
    {
      "area": "Stream updates and argument summaries",
      "problem": "Text deltas repeated work unrelated to the changing reply.",
      "cause": "Tool lists and progress derived data rebuilt on every delta; closed cards serialized complete arguments.",
      "change": "Memoize by tool/message identity, preserve current callbacks, and generate a bounded argument preview. Serialize complete arguments only when opened.",
      "expectedEffect": "Reduce repeated computation and large temporary strings while keeping complete parameters available."
    },
    {
      "area": "Tool result identity",
      "problem": "Different runs reusing a call ID could display another run’s result.",
      "cause": "The result index used call ID alone.",
      "change": "Scope results by run and call ID; infer a missing legacy run ID only when its ownership is unique.",
      "expectedEffect": "Preserve independent histories and prevent an old success from masking a current pending approval."
    },
    {
      "area": "Idle scheduling",
      "problem": "An idle scheduler sorted all jobs on every tick.",
      "cause": "The loop checked every entry even when no trigger was due.",
      "change": "Cache the earliest due time with mutation invalidation; retain wall-clock jump checks and sort only the due subset. Count valid fixed intervals arithmetically.",
      "expectedEffect": "O(1) normal idle checks and O(n + k log k) due work, with existing ordering, missed-run policy, and persistence-failure retry behavior."
    },
    {
      "area": "Saved draft retention",
      "problem": "Visited saved drafts remained in controllers, query cache, and composer copies.",
      "cause": "There was no reader-aware release path or exact saved-copy cleanup.",
      "change": "Release only unobserved, recoverable, clean controllers with no pending operation; invalidate stale snapshots and remove idle unobserved query entries and matching inactive UI copies.",
      "expectedEffect": "Allow saved bodies to be collected while retaining dirty, conflicting, failed, active, and legacy in-memory drafts."
    },
    {
      "area": "Draft safety during routing and uploads",
      "problem": "Route gaps could miss release notifications; late uploads could remain only in an inactive component.",
      "cause": "Connection-wide subscriptions switched to local fallback, and upload completion updated local component state without protecting its source controller.",
      "change": "Keep connection subscriptions stable, combine local and connection dirty state, hold explicit operation leases, merge attachments into the latest source snapshot, and maintain a connection-lifetime close guard.",
      "expectedEffect": "Preserve unsaved text and attachments across route loading, settings navigation, failed saves, and asynchronous completion."
    }
  ],
